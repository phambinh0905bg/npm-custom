{
	"operationId": "applyCertificateToHosts",
	"summary": "Apply a certificate to many hosts",
	"description": "Sets the certificate and the SSL toggles on each target host and regenerates its nginx config. Each host is reported individually, so a partial failure does not roll back the hosts that succeeded.",
	"tags": ["certificates"],
	"security": [
		{
			"bearerAuth": ["certificates.manage"]
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "certID",
			"description": "The ID of the certificate",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 1
		}
	],
	"requestBody": {
		"description": "Bulk certificate apply payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": ["targets"],
					"properties": {
						"targets": {
							"type": "array",
							"minItems": 1,
							"maxItems": 500,
							"items": {
								"type": "object",
								"additionalProperties": false,
								"required": ["host_type", "host_id"],
								"properties": {
									"host_type": {
										"type": "string",
										"enum": ["proxy", "redirection", "dead"]
									},
									"host_id": {
										"$ref": "../../../../../common.json#/properties/id"
									}
								}
							}
						},
						"ssl_forced": {
							"type": "boolean",
							"description": "Force SSL (redirect http to https). Defaults to true.",
							"example": true
						},
						"hsts_enabled": {
							"type": "boolean",
							"description": "Enable HSTS. Defaults to false.",
							"example": false
						},
						"hsts_subdomains": {
							"type": "boolean",
							"description": "Include subdomains in HSTS. Requires hsts_enabled.",
							"example": false
						},
						"http2_support": {
							"type": "boolean",
							"description": "Enable HTTP/2. Defaults to false - only enable it on a patched nginx build.",
							"example": false
						},
						"allow_uncovered": {
							"type": "boolean",
							"description": "Apply the certificate to hosts that serve a domain outside its SAN list. Without this they are refused individually.",
							"example": false
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"certificate_id": 1,
								"applied": 1,
								"failed": 0,
								"results": [
									{
										"host_type": "proxy",
										"host_id": 1,
										"status": "applied",
										"domain_names": ["app.example.com"],
										"uncovered_domains": []
									}
								]
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/bulk-ssl-apply-object.json"
					}
				}
			}
		},
		"400": {
			"description": "400 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 400,
									"message": "Invalid configuration provided"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/error-object.json"
					}
				}
			}
		},
		"401": {
			"description": "401 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 401,
									"message": "Invalid token"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/error-object.json"
					}
				}
			}
		},
		"403": {
			"description": "403 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 403,
									"message": "Permission denied"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/error-object.json"
					}
				}
			}
		},
		"404": {
			"description": "404 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 404,
									"message": "Item not found"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/error-object.json"
					}
				}
			}
		}
	}
}
