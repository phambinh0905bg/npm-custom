{
	"operationId": "previewBulkCertificateApply",
	"summary": "List the hosts a certificate would be applied to",
	"description": "Dry run. Returns every host the certificate covers, plus any host passed in host_ids even when its domains are not covered, with the uncovered domains flagged.",
	"tags": [
		"certificates"
	],
	"security": [
		{
			"bearerAuth": [
				"certificates.view"
			]
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "certID",
			"description": "The ID of the certificate",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 1
		},
		{
			"in": "query",
			"name": "host_ids",
			"description": "Comma separated host IDs to preview instead of auto-matching by domain",
			"schema": {
				"type": "string",
				"maxLength": 4000
			}
		},
		{
			"in": "query",
			"name": "targets",
			"description": "JSON array of {host_type, host_id} to preview instead of auto-matching. The host type is required because a proxy host and a 404 host can share the same id.",
			"schema": {
				"type": "string",
				"maxLength": 20000
			},
			"example": "[{\"host_type\":\"proxy\",\"host_id\":1}]"
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"certificate_id": 1,
								"nice_name": "example.com",
								"domain_names": [
									"*.example.com",
									"example.com"
								],
								"expires_on": "2027-01-01 00:00:00",
								"hosts": [
									{
										"host_type": "proxy",
										"host_id": 1,
										"domain_names": [
											"app.example.com"
										],
										"enabled": true,
										"current_certificate_id": 0,
										"uncovered_domains": [],
										"will_change": true
									}
								]
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/bulk-ssl-preview-object.json"
					}
				}
			}
		},
		"400": {
			"description": "400 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 400,
									"message": "Invalid configuration provided"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/error-object.json"
					}
				}
			}
		},
		"401": {
			"description": "401 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 401,
									"message": "Invalid token"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/error-object.json"
					}
				}
			}
		},
		"403": {
			"description": "403 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 403,
									"message": "Permission denied"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/error-object.json"
					}
				}
			}
		},
		"404": {
			"description": "404 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 404,
									"message": "Item not found"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/error-object.json"
					}
				}
			}
		}
	}
}
